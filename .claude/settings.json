{
  "$comment": "Permissions + config partagées (committed). Overrides perso : settings.local.json (gitignored).",
  "permissions": {
    "allow": [
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Read(./**)",
      "Edit(./tests/**)",
      "Edit(./pages/**)",
      "Edit(./fixtures/**)",
      "Edit(./.qa/**)"
    ],
    "deny": [
      "Edit(./utils/test-data.ts)",
      "Edit(./playwright.config.ts)",
      "Read(./.qa/agentdb/sessions/**)",
      "Read(./.env)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/qa-guard.js" },
          { "type": "command", "command": "node .claude/hooks/loop-guard.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/qa-typecheck.js", "timeout": 120 }
        ]
      }
    ]
  }
}
