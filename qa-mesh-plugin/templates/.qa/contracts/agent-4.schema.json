{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-mesh/agent-4.schema.json",
  "title": "Payload Agent 4 — Test Automation Engineer",
  "type": "object",
  "required": ["files", "scenarios_covered"],
  "properties": {
    "files": {
      "type": "object",
      "required": ["pages", "tests", "fixtures"],
      "properties": {
        "pages": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fixtures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenarios_covered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "spec", "test_title"],
        "properties": {
          "scenario_id": { "type": "string" },
          "spec": { "type": "string" },
          "test_title": { "type": "string" },
          "skipped": { "type": "string", "description": "raison si non généré (ex: selector_unresolved)" }
        }
      }
    },
    "selectors_added": { "type": "integer", "minimum": 0 },
    "compile_check": { "enum": ["passed", "failed"] }
  }
}
