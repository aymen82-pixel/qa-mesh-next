{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-mesh/agent-spec.schema.json",
  "title": "Payload Agent SPEC — Spec Writer (SDD)",
  "type": "object",
  "required": ["sfd_path", "features", "open_questions", "summary"],
  "properties": {
    "sfd_path": { "type": "string" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "priority", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-\\d{3}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "$ref": "envelope.schema.json#/definitions/priority" },
          "rules": { "type": "array", "items": { "type": "string" } },
          "error_cases": { "type": "array", "items": { "type": "string" } },
          "actors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "impact", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-\\d{3}$" },
          "question": { "type": "string" },
          "impact": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["features_total", "questions_total", "blocking_questions"],
      "properties": {
        "features_total": { "type": "integer", "minimum": 1 },
        "questions_total": { "type": "integer", "minimum": 0 },
        "blocking_questions": { "type": "integer", "minimum": 0 },
        "source_files": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
