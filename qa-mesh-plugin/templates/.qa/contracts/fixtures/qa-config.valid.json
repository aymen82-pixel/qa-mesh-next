{
  "$comment": "Configuration projet — SEUL fichier contenant des données spécifiques au projet. Copier vers .qa/qa.config.json et adapter.",
  "base_url": "https://app.example.com",
  "language": "fr",
  "test_management_tool": "xray",
  "paths": {
    "testDir": "tests",
    "pagesDir": "pages",
    "fixturesDir": "fixtures",
    "docsDir": "docs/qa",
    "test_data": "utils/test-data.ts"
  },
  "run_command": "npx playwright test {path} --reporter=json",
  "compile_command": "npx tsc --noEmit",
  "known_routes": [],
  "excluded_routes": [
    "/admin/system"
  ],
  "roles": [
    {
      "name": "default",
      "username_env": "QA_DEFAULT_USER",
      "password_env": "QA_DEFAULT_PASSWORD",
      "default": true
    }
  ],
  "secrets": [
    {
      "name": "api-token",
      "env": "API_TOKEN"
    }
  ],
  "auth": {
    "login_url": "/login",
    "steps": [
      "fill role=textbox[name~=email] with $username",
      "fill input[type=password] with $password",
      "click role=button[name~=connect|login|sign in]",
      "wait url!=/login"
    ],
    "session_ttl_hours": 24,
    "$comment": "Connexion déterministe : tests/auth.setup.ts + pages/login.page.ts, lancée par `qa-mesh session refresh --role <r>`. `steps` est une description pour adapter le POM, jamais exécutée par un agent."
  },
  "budgets": {
    "max_retries_per_agent": 2,
    "max_heal_attempts_per_test": 3,
    "max_heal_passes": 1,
    "max_session_refresh": 2,
    "max_snapshots_per_page": 2,
    "a11y_max_pages": 15
  },
  "specialists": {
    "a11y": false,
    "compliance": false,
    "perf": false
  },
  "compliance": {
    "ai_features": false,
    "personal_data": true,
    "high_risk_ai": false
  },
  "perf": {
    "max_pages": 10,
    "budgets": {
      "lcp_ms": 2500,
      "cls": 0.1,
      "ttfb_ms": 800,
      "fcp_ms": 1800
    },
    "load": {
      "allowed": false,
      "target_env": "",
      "script_path": "",
      "vus": 10,
      "duration": "1m"
    }
  },
  "sdd": {
    "input_dir": "input",
    "output_dir": ".qa/sdd"
  },
  "coverage_intelligence": {
    "$comment": "Priorisation par le risque (étape 9). Tous les champs sont optionnels — le kernel applique des défauts. Voir COVERAGE-INTELLIGENCE.md.",
    "business_risk": {
      "checkout": 10,
      "login": 8,
      "profile": 2
    },
    "floors": {
      "checkout": 40,
      "payment": 40,
      "login": 30
    },
    "weights": {
      "business": 0.3,
      "criticality": 0.2,
      "failure": 0.2,
      "git": 0.2,
      "stability": 0.1
    },
    "max_staleness_days": 14,
    "staleness_floor": 70,
    "stability_window": 5,
    "recency_tau_days": 14,
    "path_domain_map": {
      "src/billing": "checkout"
    }
  },
  "explore": {
    "max_charters": 8,
    "max_steps_per_charter": 40,
    "max_duration_min": 10,
    "parallelism": 1
  },
  "known_non_bugs": [
    "Un lien qui ouvre un nouvel onglet laisse la page courante inchangée.",
    "Les images se chargent à l'affichage (lazy loading) : défiler et attendre avant de conclure qu'une image est vide."
  ],
  "bugbash": {
    "shared_env": true
  }
}
